# Copy to .env. Secrets only: tokens, keys, database URLs. Every other setting
# is in config.toml (committed, read below the environment), so a line here
# still overrides it locally, but only the names below are published to the
# deployment by tools/sync_control_secret.py.

# The key of a model set in config.toml: MODEL_<SET>_API_KEY, upper case.
# A set without one uses MODEL_API_KEY, so the Modal Apps (int4, qwen, v2),
# which share one `wk-....ws-...` proxy token, need only that line.
MODEL_OR_API_KEY=
# MODEL_GEMINI_API_KEY=
# MODEL_COMET_API_KEY=
# MODEL_API_KEY=

# Telegram. TELEGRAM_ALLOWED_USERS is a comma-separated list of numeric user
# ids; an empty list means nobody may use the bot.
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USERS=

# Deployed profile only: pooled PostgreSQL DSN with TLS options. Locally the
# SQLite files named in config.toml are used and this stays empty.
# AGENT_DATABASE_URL=
# AGENT_DATABASE_SCHEMA=public

# The web. Empty search key means no search tool at all, rather than one that
# fails. The renderer's proxy token pairs with the address below.
WEB_FIRECRAWL_API_KEY=
# WEB_RENDERER_KEY=
# The deployed renderer's address, published as WEB_RENDERER_URL. Named
# DEPLOY_ here so the local profile never sends its page views there.
# DEPLOY_WEB_RENDERER_URL=
# A client name and contact for sites that refuse an anonymous browser
# (Wikimedia does): `name/version (contact)`. Personal, so it is not in the file.
# WEB_FALLBACK_USER_AGENT=

# Any config.toml setting can still be overridden here for this machine, by
# its environment name: MODEL_<SET>_<FIELD>, AGENT_<FIELD>, WEB_<FIELD>,
# TELEGRAM_<FIELD>; MODEL chooses the set. Such lines are not published.
# CONFIG_FILE names another file; empty reads none.
